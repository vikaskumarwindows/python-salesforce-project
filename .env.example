# ==============================================================================
# Salesforce & Python Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: Never commit your actual '.env' file to Git!
# ==============================================================================

# Option 1: Direct Authentication (Username + Password + Security Token)
SALESFORCE_USERNAME=your_username@yourdomain.com
SALESFORCE_PASSWORD=your_password
SALESFORCE_SECURITY_TOKEN=your_security_token
# Domain: 'login' (Production / Developer Org) or 'test' (Sandbox)
SALESFORCE_DOMAIN=login

# Option 2: Connected App / OAuth 2.0 (Client Credentials or JWT)
# SALESFORCE_CLIENT_ID=3MVG9...
# SALESFORCE_CLIENT_SECRET=...
# SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com

# Optional: API Version (default is typically 59.0 or 60.0+)
# SALESFORCE_API_VERSION=60.0
