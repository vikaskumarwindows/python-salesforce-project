# ==============================================================================
# Python & Salesforce Combined .gitignore
# ==============================================================================

# --------------------------------------------------
# Python Virtual Environments & Packages
# --------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, typing, and linting
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter / IPython
.ipynb_checkpoints

# --------------------------------------------------
# Environment Secrets & Credentials
# --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
jwt/

# --------------------------------------------------
# Salesforce CLI (sf / sfdx) & Local Development
# --------------------------------------------------
.sf/
.sfdx/
.localdevserver/

# Salesforce Logs & Anonymous Apex dumps
*.log
salesforce.log
sfdx.log
apex-execution-*.log
.apex/

# Salesforce Data / Query Dumps (prevent leaking production data)
data/export/
data/dump/
*.soql.json

# --------------------------------------------------
# IDEs & Editors & Agent State
# --------------------------------------------------
.agents/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# --------------------------------------------------
# Operating System Files
# --------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
