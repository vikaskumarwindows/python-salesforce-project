# Auto detect text files and perform LF normalization on checkin
* text=auto

# Python source
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env.example text eol=lf

# Salesforce Metadata / Source (Salesforce CLI requires LF)
*.cls text eol=lf
*.trigger text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf

# Markdown and Docs
*.md text eol=lf

# Shell / Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
